# Copy to .env and fill in. Never commit .env. Keys are only read by the server.
# Meta Model API (keys look like LLM_<id>_<secret>)
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
SMITH_MODEL=muse-spark-1.3
IMAGE_MODEL=muse-image-1.0
TRANSCRIBE_MODEL=muse-voice-transcribe-1.0
# Baseten (Muse Spark Open). Confirm the slug with GET /v1/models.
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
VILLAGER_MODEL=meta-models/muse-spark-open
PORT=8787
# On the host: production turns on the Secure cookie flag (needs HTTPS)
NODE_ENV=
# Behind a proxy, the header that carries the visitor's address (e.g. x-forwarded-for or x-real-ip; check the host's docs).
# Empty = use the socket address (right for local dev, wrong behind a proxy: everyone would share one address)
TRUST_PROXY_HEADER=
# Path to a recorded JSONL log to replay model responses instead of calling the APIs
REPLAY=
