{
  "name": "npc-workshop",
  "version": "0.1.0",
  "description": "Authoring and testing tool for LLM-driven game NPCs whose actions are checked by a deterministic ledger.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p shared && tsc -p server && tsc -p web && tsc -p scripts && tsc -p examples/game-backend && tsc -p examples/skyrim",
    "skyrim": "node --import tsx examples/skyrim/run.ts",
    "game-example": "node --import tsx examples/game-backend/game.mjs",
    "smith-demo": "tsx scripts/smith-demo.ts",
    "latency-test": "tsx scripts/latency-test.ts",
    "make-map": "tsx scripts/make-map.ts",
    "exploit-suite": "tsx scripts/exploit-suite.ts",
    "ledger-proof": "tsx scripts/ledger-proof.ts",
    "recognition-live": "tsx scripts/recognition-live.ts"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
