{
  "name": "blacksmith",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p shared && tsc -p server && tsc -p web && tsc -p scripts && tsc -p examples/game-backend",
    "game-example": "node --import tsx examples/game-backend/game.mjs",
    "smith-demo": "tsx scripts/smith-demo.ts",
    "latency-test": "tsx scripts/latency-test.ts",
    "make-map": "tsx scripts/make-map.ts",
    "reply-time": "tsx scripts/reply-time.ts",
    "rival-convai": "tsx scripts/rival-convai.ts",
    "rival-chat": "tsx scripts/rival-chat.ts",
    "exploit-suite": "tsx scripts/exploit-suite.ts",
    "ledger-proof": "tsx scripts/ledger-proof.ts"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
